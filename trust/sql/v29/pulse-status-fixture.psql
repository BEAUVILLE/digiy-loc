\set ON_ERROR_STOP on
-- Disposable database only; no real notification data.
CREATE ROLE anon NOLOGIN;
CREATE ROLE authenticated NOLOGIN;
CREATE ROLE service_role NOLOGIN BYPASSRLS;

CREATE TABLE public.v29_pulse_status_fixture (
  id uuid PRIMARY KEY,
  status text NOT NULL DEFAULT 'new',
  sent_at timestamptz,
  last_error text,
  attempts integer NOT NULL DEFAULT 0,
  provider text,
  provider_message_id text,
  locked_by text
);
ALTER TABLE public.v29_pulse_status_fixture ENABLE ROW LEVEL SECURITY;
INSERT INTO public.v29_pulse_status_fixture(id)
VALUES ('00000000-0000-4000-8000-000000000021');

CREATE FUNCTION public.digiy_loc_pulse_mark_sent(p_id uuid)
RETURNS json LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=public
AS $fn$
BEGIN
  UPDATE public.v29_pulse_status_fixture SET sent_at=now(),last_error=NULL
  WHERE id=p_id;
  RETURN json_build_object('ok',found);
END
$fn$;

CREATE FUNCTION public.digiy_loc_pulse_mark_sent(
  p_pulse_id uuid,
  p_provider text DEFAULT NULL,
  p_message_id text DEFAULT NULL,
  p_worker_id text DEFAULT NULL
) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=public
AS $fn$
BEGIN
  UPDATE public.v29_pulse_status_fixture
  SET status='sent',sent_at=now(),provider=p_provider,
      provider_message_id=p_message_id,locked_by=NULL
  WHERE id=p_pulse_id;
  RETURN jsonb_build_object('ok',found,'worker_id',p_worker_id);
END
$fn$;

CREATE FUNCTION public.digiy_loc_pulse_fail_backoff(
  p_pulse_id uuid,p_error_code text,p_error_message text,
  p_worker_id text DEFAULT NULL
) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER
SET search_path=public
AS $fn$
BEGIN
  UPDATE public.v29_pulse_status_fixture
    SET status='new', attempts=attempts+1,
      last_error=p_error_code || ': ' || p_error_message,
      locked_by=NULL
  WHERE id=p_pulse_id;
  RETURN jsonb_build_object('ok',found,'worker_id',p_worker_id);
END
$fn$;

CREATE FUNCTION public.v29_status_unrelated_public_rpc()
RETURNS integer LANGUAGE sql AS $fn$ SELECT 1 $fn$;

GRANT EXECUTE ON FUNCTION public.digiy_loc_pulse_mark_sent(uuid)
  TO anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.digiy_loc_pulse_mark_sent(uuid,text,text,text)
  TO anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION public.digiy_loc_pulse_fail_backoff(uuid,text,text,text)
  TO anon,authenticated,service_role;
