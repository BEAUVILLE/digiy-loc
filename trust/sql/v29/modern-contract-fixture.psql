\set ON_ERROR_STOP on
-- PRIVATE, DISPOSABLE TEST ONLY. Only actual *function definitions* are
-- replayed; all data, schema rows, owner IDs, phones and slugs are fictitious.
-- Source contracts inspected read-only in digiy-core on 2026-10-08.
\ir ci-roles.psql
CREATE SCHEMA auth;
CREATE OR REPLACE FUNCTION auth.uid() RETURNS uuid
LANGUAGE sql STABLE AS $test$
 SELECT nullif(current_setting('request.jwt.claim.sub',true),'')::uuid
$test$;
GRANT USAGE ON SCHEMA auth TO anon,authenticated,service_role;
GRANT EXECUTE ON FUNCTION auth.uid() TO anon,authenticated,service_role;
CREATE TABLE public.digiy_loc_master_sites(
  id uuid PRIMARY KEY,
  owner_id uuid NOT NULL,
  slug text NOT NULL,
  display_name text NOT NULL
);
CREATE TABLE public.digiy_loc_master_units(
  id uuid PRIMARY KEY,
  site_id uuid NOT NULL REFERENCES public.digiy_loc_master_sites(id),
  slug text NOT NULL,
  display_name text NOT NULL
);
CREATE TABLE public.digiy_loc_master_reservations(
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  unit_id uuid NOT NULL REFERENCES public.digiy_loc_master_units(id),
  guest_name text NOT NULL,
  guest_phone text NOT NULL,
  source text,
  start_day date NOT NULL,
  end_day date NOT NULL,
  note text,
  created_by uuid NOT NULL,
  created_at timestamptz NOT NULL DEFAULT now(),
  updated_at timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE public.digiy_loc_master_unit_calendar(
  unit_id uuid NOT NULL REFERENCES public.digiy_loc_master_units(id),
  day date NOT NULL,
  status text NOT NULL,
  updated_at timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT digiy_loc_master_unit_calendar_pkey PRIMARY KEY (unit_id,day)
);
CREATE TABLE public.digiy_loc_rooms(
  id uuid PRIMARY KEY,
  owner_id uuid NOT NULL,
  slug text,
  is_public boolean NOT NULL DEFAULT false,
  status text NOT NULL DEFAULT 'actif',
  nom text,
  adresse text,
  city text,
  quartier text,
  country text,
  type_logement text,
  personnes_max integer,
  prix_nuit integer,
  prix_semaine integer,
  prix_mois integer,
  description text,
  photo_url text,
  gallery_urls jsonb,
  video_url text,
  cover_mode text,
  owner_name text,
  tagline text,
  hero_badges jsonb,
  amenities jsonb,
  short_rules text,
  senelec_note text,
  deposit_percent integer,
  payment_note text,
  wave_name text,
  whatsapp_phone text,
  call_phone text,
  is_featured boolean,
  public_url text
);
